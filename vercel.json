{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "dist/src/server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/.*",
      "dest": "dist/src/server.js"
    },
    {
      "src": ".*",
      "dest": "dist/src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-availability",
      "schedule": "* * * * *"
    }
  ]
}
