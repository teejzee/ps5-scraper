{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/dist/src/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-availability",
      "schedule": "* * * * *"
    }
  ]
}
